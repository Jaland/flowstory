  "tooltips": {
    "cluster": {
      "title": "OpenShift Cluster",
      "description": "All MaaS multi-tenancy resources run within a single OpenShift cluster. Isolation is logical (namespace-based), not physical.",
      "details": [
        ["Isolation", "Namespace-based, label-driven"],
        ["Control Plane", "Shared maas-controller instance"],
        ["Tenants", "Multiple tenant namespaces per cluster"],
        ["Gateway", "Shared openshift-ingress"]
      ]
    },
    "aigateway-cr": {
      "title": "AIGateway Custom Resource",
      "description": "New CR that replaces the Tenant CR. Lives in models-as-a-service namespace. Creating it triggers the maas-controller to provision a full tenant environment.",
      "details": [
        ["Namespace", "models-as-a-service"],
        ["Creates", "Tenant namespace with label"],
        ["Contains", "Tenant config metadata"],
        ["Owned by", "MaaS Admin"]
      ]
    },
    "tenant-ns": {
      "title": "Tenant Admin Namespace",
      "description": "Automatically created namespace for each tenant. Contains all tenant-scoped MaaS resources including subscriptions and auth policies.",
      "details": [
        ["Label", "maas.opendatahub.io/tenant: acme"],
        ["Contains", "MaaSSubscription, MaaSAuthPolicy"],
        ["Created by", "maas-controller (AIGateway reconciler)"],
        ["Watched by", "maas-controller"]
      ]
    },
    "subscription": {
      "title": "MaaSSubscription",
      "description": "Defines model quota and token rate limits for this tenant. Created by MaaS Admin in the tenant namespace.",
      "details": [
        ["Namespace", "tenant-acme-ns"],
        ["Defines", "Token rate limits, model quotas"],
        ["Created by", "MaaS Admin"],
        ["Reconciled to", "TokenRateLimitPolicy in model namespace"]
      ]
    },
    "authpolicy-cr": {
      "title": "MaaSAuthPolicy",
      "description": "Defines who can access which models for this tenant. Created by MaaS Admin in the tenant namespace.",
      "details": [
        ["Namespace", "tenant-acme-ns"],
        ["Defines", "Groups, users, OIDC claims"],
        ["Created by", "MaaS Admin"],
        ["Reconciled to", "AuthPolicy in openshift-ingress"]
      ]
    },
    "maas-controller": {
      "title": "MaaS Controller",
      "description": "Watches tenant namespaces and reconciles MaaS CRs into Kuadrant policies. Also handles AIGateway CR reconciliation. Single instance serves all tenants.",
      "details": [
        ["Namespace", "redhat-ai-applications"],
        ["Watches", "AIGateway CRs, labeled tenant namespaces"],
        ["Creates", "Tenant namespaces, AuthPolicy, TokenRateLimitPolicy"],
        ["Aggregates", "Multiple tenant CRs per model"]
      ]
    },
    "modelref": {
      "title": "MaaSModelRef",
      "description": "Stable reference to the model workload. Lives in the same namespace as the model. Created by Model Deployer.",
      "details": [
        ["Namespace", "ml-models (model namespace)"],
        ["Points to", "LLMInferenceService or ExternalModel"],
        ["Creates", "HTTPRoute for /v1/chat/completions"],
        ["Created by", "Model Deployer"]
      ]
    },
    "authpolicy": {
      "title": "AuthPolicy (Kuadrant)",
      "description": "Kuadrant AuthPolicy in openshift-ingress namespace. Aggregated from all MaaSAuthPolicy CRs that reference this model.",
      "details": [
        ["Namespace", "openshift-ingress"],
        ["Source", "MaaSAuthPolicy in tenant-acme-ns"],
        ["Attached to", "Gateway (via targetRef)"],
        ["Created by", "maas-controller"]
      ]
    },
    "ratelimit": {
      "title": "TokenRateLimitPolicy (Kuadrant)",
      "description": "Kuadrant rate limiting policy in the model namespace. Aggregated from all MaaSSubscription CRs that reference this model.",
      "details": [
        ["Namespace", "ml-models (same as model)"],
        ["Source", "MaaSSubscription in tenant-acme-ns"],
        ["Attached to", "HTTPRoute (via targetRef)"],
        ["Created by", "maas-controller"]
      ]
    },
    "ingress-ns": {
      "title": "openshift-ingress Namespace",
      "description": "OpenShift's default ingress namespace where Gateway API resources and AuthPolicy live.",
      "details": [
        ["Purpose", "Gateway and auth policy resources"],
        ["Contains", "Gateway API, AuthPolicy (Kuadrant)"],
        ["Managed by", "OpenShift Ingress Operator + maas-controller"]
      ]
    }
  },
  "flows": {
    "main": {
      "label": "Policy Creation Flow",
      "steps": [
        {
          "text": "MaaS Admin creates AIGateway CR in models-as-a-service namespace",
          "mode": "arrow",
          "from": "maas-admin",
          "to": "aigateway-cr",
          "color": "#d2a8ff",
          "num": 1,
          "fromRight": true,
          "toLeft": true,
          "waypoints": [
            { "x": 700, "y": 350 },
            { "x": 700, "y": 277 }
          ]
        },
        {
          "text": "maas-controller watches AIGateway CR",
          "mode": "arrow",
          "from": "maas-controller",
          "to": "aigateway-cr",
          "color": "#d2a8ff",
          "num": 2,
          "fromRight": true,
          "toLeft": true,
          "waypoints": [
            { "x": 650, "y": 277 }
          ]
        },
        {
          "text": "maas-controller creates tenant namespace with label",
          "mode": "arrow",
          "from": "maas-controller",
          "to": "tenant-ns",
          "color": "#d2a8ff",
          "num": 3,
          "fromBottom": true,
          "toTop": true,
          "waypoints": [
            { "x": 240, "y": 350 }
          ]
        },
        {
          "text": "Model Deployer creates LLMInferenceService in their namespace",
          "mode": "arrow",
          "from": "model-deployer",
          "to": "model",
          "color": "#3fb950",
          "num": 4,
          "fromRight": true,
          "toLeft": true
        },
        {
          "text": "Model Deployer creates MaaSModelRef pointing to the model",
          "mode": "arrow",
          "from": "model-deployer",
          "to": "modelref",
          "color": "#58a6ff",
          "num": 5,
          "fromRight": true,
          "toLeft": true,
          "waypoints": [
            { "x": 80, "y": 685 }
          ]
        },
        {
          "text": "MaaSModelRef controller creates HTTPRoute for the model",
          "mode": "arrow",
          "from": "modelref",
          "to": "httproute",
          "color": "#79c0ff",
          "num": 6,
          "fromBottom": true,
          "toTop": true
        },
        {
          "text": "MaaS Admin creates MaaSSubscription and MaaSAuthPolicy in tenant namespace",
          "mode": "arrow",
          "from": "maas-admin",
          "to": "subscription",
          "color": "#58a6ff",
          "num": 7,
          "fromRight": true,
          "toLeft": true,
          "waypoints": [
            { "x": 280, "y": 410 }
          ]
        },
        {
          "text": "MaaS Admin also creates MaaSAuthPolicy",
          "mode": "arrow",
          "from": "maas-admin",
          "to": "authpolicy-cr",
          "color": "#3fb950",
          "num": 8,
          "fromRight": true,
          "toLeft": true,
          "waypoints": [
            { "x": 280, "y": 490 }
          ]
        },
        {
          "text": "maas-controller watches tenant namespace for both MaaSSubscription and MaaSAuthPolicy",
          "mode": "arrow",
          "from": "maas-controller",
          "to": "tenant-ns",
          "color": "#58a6ff",
          "num": 9,
          "fromBottom": true,
          "toTop": true,
          "waypoints": [
            { "x": 240, "y": 350 },
            { "x": 550, "y": 350 }
          ]
        },
        {
          "text": "maas-controller creates TokenRateLimitPolicy in model namespace",
          "mode": "arrow",
          "from": "maas-controller",
          "to": "ratelimit",
          "color": "#d2a8ff",
          "num": 10,
          "fromBottom": true,
          "toTop": true,
          "waypoints": [
            { "x": 320, "y": 540 },
            { "x": 775, "y": 540 }
          ]
        },
        {
          "text": "maas-controller creates AuthPolicy in openshift-ingress namespace",
          "mode": "arrow",
          "from": "maas-controller",
          "to": "authpolicy",
          "color": "#d2a8ff",
          "num": 11,
          "fromTop": true,
          "toBottom": true,
          "waypoints": [
            { "x": 240, "y": 190 },
            { "x": 550, "y": 190 }
          ]
        },
        {
          "text": "TokenRateLimitPolicy attached to HTTPRoute via targetRef",
          "mode": "arrow",
          "from": "ratelimit",
          "to": "httproute",
          "color": "#d2a8ff",
          "num": 12,
          "fromLeft": true,
          "toRight": true
        },
        {
          "text": "HTTPRoute now has tenant-scoped auth and rate limiting policies",
          "mode": "lightup",
          "target": "httproute",
          "badge": "✓"
        }
      ]
    }
  },
  "legend": [
    { "label": "MaaS Control Plane", "color": "#58a6ff" },
    { "label": "Tenant Resources", "color": "#d2a8ff" },
    { "label": "Model Resources", "color": "#3fb950" },
    { "label": "Gateway/Ingress", "color": "#f0883e" },
    { "label": "Kuadrant Objects", "color": "#d2a8ff" },
    { "label": "HTTPRoute", "color": "#79c0ff" }
  ],
  "defaultFlow": "main"
}
